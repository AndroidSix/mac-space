{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacSpace",
  "version": "0.2.0",
  "identifier": "local.macspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "清衡 · MacSpace",
      "width": 1240,
      "height": 840,
      "minWidth": 900,
      "minHeight": 640,
      "backgroundColor": "#11171c"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utilities",
    "shortDescription": "清晰管理磁盘空间、进程负载与机器温度",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
