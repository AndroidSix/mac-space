{
  "name": "system-balance",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "description": "System Balance · Local disk, workload and power management for macOS and Windows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndroidSix/mac-space.git"
  },
  "bugs": {
    "url": "https://github.com/AndroidSix/mac-space/issues"
  },
  "homepage": "https://github.com/AndroidSix/mac-space#readme",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "tauri": "node scripts/tauri.mjs",
    "package:pkg": "node scripts/package.mjs",
    "test:native": "node scripts/tauri.mjs test-native",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
